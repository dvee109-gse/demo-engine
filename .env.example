# --- Server ---
PORT=3000
# Public base URL where /demos is reachable (used to build the link GHL emails to the prospect)
DEMO_BASE_URL=https://demo.youragency.com

# --- GHL auth ---
# Agency Settings -> Private Integrations -> create a token scoped to your sub-account,
# with Conversation AI and Knowledge Base read/write permissions.
GHL_PIT_TOKEN=
GHL_LOCATION_ID=
GHL_API_BASE_URL=https://services.leadconnectorhq.com
# The Knowledge Base API docs specify "Version: v3" — different from the classic
# 2021-07-28 version header used by most other v2 endpoints. Keep both, confirm
# current values against your GHL API reference before relying on them.
GHL_API_VERSION=2021-07-28
GHL_KB_API_VERSION=v3

# --- The shared "demo bot" (Option A: one bot, reprimed per prospect) ---
# Create these once by hand in GHL, then paste the IDs here.
GHL_KNOWLEDGE_BASE_ID=
GHL_AGENT_ID=
# Snippet GHL gives you for embedding this bot's chat widget (Sites > Chat Widget).
GHL_CHAT_WIDGET_EMBED=
# The LC Phone number bound to the Voice AI agent, shown as the "call it" CTA.
GHL_VOICE_NUMBER=+1XXXXXXXXXX

# --- Callback into GHL ---
# The unique URL generated by the "Inbound Webhook" trigger step in your
# "AI Mockup Sent" workflow (see blueprint §3.4).
GHL_DEMO_READY_WEBHOOK_URL=
# Optional but recommended: a second "Inbound Webhook" workflow that tags the
# contact "Needs Review" and pings you internally, instead of auto-emailing a
# prospect a broken demo. Fired when qualityGate.js flags a dead/parked site.
GHL_NEEDS_REVIEW_WEBHOOK_URL=

# --- Optional: shared secret to verify inbound requests are really from GHL ---
INBOUND_WEBHOOK_SECRET=

# --- Optional: LLM extraction pass (src/llmExtractor.js) ---
# Fills services/FAQ content for sites whose DOM doesn't structure it that way
# (see the blueprint's stress-test notes on cooperbuilthomes.com). Without a
# key, the pipeline just runs on DOM heuristics alone — nothing breaks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Optional: only needed for scripts/seedTestLead.js (test-lead creation) ---
# Fill these in after you've manually built the pipeline in GHL and run
# `npm run list:pipelines` to see the IDs.
GHL_PIPELINE_ID=
GHL_STAGE_NEW_LEAD_ID=

# Custom field IDs printed by `npm run setup:fields` (needed to actually write
# values into Website URL / Business Name — GHL's contact update takes field
# IDs, not the {{contact.x}} merge-tag names).
GHL_FIELD_WEBSITE_URL_ID=
GHL_FIELD_BUSINESS_NAME_ID=
# Repurposed to store demo-page render data as JSON (logoUrl/primaryColor/heroText)
# so pages survive Render's ephemeral filesystem — see demoPageBuilder.js.
GHL_FIELD_SERVICES_SUMMARY_ID=

# Forwarding target for the /beacon endpoint (a *second* GHL inbound webhook —
# the one wired to the "AI Mockup Opened" workflow, separate from the demo-ready one).
BEACON_FORWARD_URL=
